<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Release builds never allow cleartext; debug overrides add the emulator host. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
