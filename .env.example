# Copy this file to the repository root as ".env" and replace every value.
# .env is git-ignored. Never commit real credentials.

# PostgreSQL
POSTGRES_DB=proxilink
POSTGRES_USER=proxilink
POSTGRES_PASSWORD=CHANGE_ME_postgres_9

# Signing key: at least 32 bytes. Generate with: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48

# Browser origins that may call the API and open the WebSocket.
# Use the exact dashboard origin; wildcards are rejected by the prod profile.
CORS_ALLOWED_ORIGINS=http://localhost:8081
WS_ALLOWED_ORIGINS=http://localhost:8081

# First administrator. Created only when the database has no users.
# Password: >= 12 characters, at least one letter and one digit, no CHANGE_ME prefix.
# Change it after the first login, then set BOOTSTRAP_ADMIN_ENABLED=false.
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_choose_a_strong_password_9
BOOTSTRAP_ORGANIZATION=ProxiLink
