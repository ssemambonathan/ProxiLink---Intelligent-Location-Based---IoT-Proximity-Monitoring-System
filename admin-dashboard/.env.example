# Optional overrides. By default the app uses the Vite dev proxy:
#   /api/* -> http://localhost:8080/api/*
#   /ws    -> ws://localhost:8080/ws
# Leave these unset for local development.

# API base URL. Either a full base including the version, e.g.
# http://localhost:8080/api/v1, or a host origin such as https://api.example.com
# (the app appends /api/v1 when only an origin is supplied).
# VITE_API_URL=

# WebSocket URL override, e.g. wss://api.example.com/ws
# When unset the URL is derived from window.location: ws(s)://<host>/ws?token=...
# VITE_WS_URL=
